# Copy this file to .env and adjust for your local environment.
# In Docker, DATABASE_URL is set via docker-compose.yml and overrides this file.

DATABASE_URL=postgresql+asyncpg://archiveuser:archivepass@localhost:5442/modaldb

# Alleen nodig voor lokale dev-scripts en sync-tests (scripts/*.py, tests/conftest.py
# db_conn-fixture). Gebruikt het psycopg-pakket (v3, niet psycopg2!) — dat zit al
# in requirements.txt. Niet gebruikt door de draaiende app zelf.
DATABASE_URL_SYNC=postgresql+psycopg://archiveuser:archivepass@localhost:5442/modaldb

AGENT_URL=http://localhost:9090
TIKA_URL=http://localhost:7777
OLLAMA_URL=http://localhost:11434

NER_FOLDER_TOP_N=25